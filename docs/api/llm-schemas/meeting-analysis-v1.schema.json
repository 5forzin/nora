{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nora:schemas:meeting-analysis:v1",
  "title": "MeetingAnalysisV1",
  "description": "Resultado estruturado da análise de uma reunião pelo LLM, validado pelo NLP Worker antes de ser persistido pelo backend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decisions", "actionItems", "risks", "opportunities", "sentimentOverall", "topics"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 2000,
      "description": "Resumo executivo em Markdown, no idioma da transcrição, preservando valores, limites, quantidades, datas corrigidas e condições de aprovação explicitamente registrados."
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "confidence"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "actionItems": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "priority", "sourceQuote"],
        "properties": {
          "title": { "type": "string", "minLength": 5, "maxLength": 240 },
          "assignee": { "type": ["string", "null"], "maxLength": 120 },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "severity", "category", "sourceQuote"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "category": {
            "type": "string",
            "enum": ["COMPETITION", "PRICE", "CHURN", "TIMELINE", "TECHNICAL", "COMPLIANCE", "OTHER"]
          },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "estimatedValue", "category", "sourceQuote"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "estimatedValue": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "category": {
            "type": "string",
            "enum": ["UPSELL", "CROSS_SELL", "REFERRAL", "EXPANSION", "OTHER"]
          },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "sentimentOverall": {
      "type": "string",
      "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "MIXED"]
    },
    "topics": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "participants": {
      "type": "array",
      "maxItems": 30,
      "description": "Participantes mencionados na transcrição (US13). Default vazio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mentionCount"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "role": { "type": ["string", "null"], "maxLength": 120 },
          "mentionCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "baselineTerms": {
      "type": "array",
      "maxItems": 50,
      "description": "Termos TF-IDF extraídos pelo nlp-baseline ANTES do LLM (interpretável, ADR 0010). Preenchido pelo worker pós-redação PII; não é gerado pelo LLM. Default vazio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "score"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 120 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "productivity": {
      "type": ["object", "null"],
      "description": "Avaliação de produtividade da reunião. Presente apenas quando o usuário ativou o recurso e declarou objetivo/outcomes esperados.",
      "additionalProperties": false,
      "required": ["score", "band", "coverage", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "coverage": {
          "type": "array",
          "description": "Para cada outcome esperado declarado, status de cobertura na reunião.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectedOutcome", "status"],
            "properties": {
              "expectedOutcome": { "type": "string", "minLength": 3, "maxLength": 240 },
              "status": { "type": "string", "enum": ["ADDRESSED", "PARTIAL", "MISSED"] },
              "evidence": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        },
        "offTopicRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "decisionDensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    },
    "customerConfidence": {
      "type": ["object", "null"],
      "description": "Confiança do cliente/lead na nossa empresa, derivada de sentimento, sinais de compra e objeções (ADR 0006; persistência mínima ADR 0015). EMITIDO pelo worker para reuniões externas (conversa com cliente/lead/venda); null para reuniões internas — o LLM decide com base no conteúdo da transcrição. Complementa (não substitui) o Account Health Score temporal.",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "trend": {
          "type": ["string", "null"],
          "enum": ["IMPROVING", "STABLE", "DECLINING", null],
          "description": "Comparacao com a ultima reuniao da mesma conta; null se for a primeira reuniao da conta."
        },
        "accountName": {
          "type": ["string", "null"],
          "maxLength": 120,
          "description": "Nome do cliente/empresa detectado pelo LLM na transcrição quando a reunião é uma conversa com cliente/lead. null quando não identificável."
        },
        "buyingSignals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "quote"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["BUDGET_DISCUSSED", "TIMELINE_DISCUSSED", "STAKEHOLDER_INVOLVED", "NEXT_STEP_REQUESTED", "REFERENCE_REQUESTED", "PROPOSAL_REQUESTED", "OTHER"]
              },
              "quote": { "type": "string", "minLength": 5, "maxLength": 500 },
              "weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "objections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "quote", "severity"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["PRICE", "TIMELINE", "AUTHORITY", "NEED", "COMPETITOR_MENTION", "TRUST", "FEATURE_GAP", "OTHER"]
              },
              "quote": { "type": "string", "minLength": 5, "maxLength": 500 },
              "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
              "competitor": { "type": ["string", "null"], "maxLength": 120 }
            }
          }
        },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    },
    "commercialIntelligence": {
      "description": "Optional Enterprise observations grounded in the shielded transcript. Omitted or null for older responses and Core workspaces.",
      "anyOf": [{ "$ref": "#/$defs/CommercialIntelligence" }, { "type": "null" }],
      "default": null
    }
  },
  "$defs": {
    "BudgetApproval": {
      "enum": [
        "APPROVED",
        "NOT_APPROVED",
        "UNKNOWN"
      ],
      "title": "BudgetApproval",
      "type": "string"
    },
    "BudgetKind": {
      "enum": [
        "BUDGET",
        "PROPOSAL",
        "PRICE",
        "REVENUE",
        "OTHER"
      ],
      "title": "BudgetKind",
      "type": "string"
    },
    "CommercialBudget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "kind": {
          "$ref": "#/$defs/BudgetKind"
        },
        "approval": {
          "$ref": "#/$defs/BudgetApproval"
        },
        "period": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "sourceQuote": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Sourcequote",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "approval",
        "sourceQuote"
      ],
      "title": "CommercialBudget",
      "type": "object"
    },
    "CommercialPersona": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "decisionRole": {
          "$ref": "#/$defs/DecisionRole"
        },
        "sourceQuote": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Sourcequote",
          "type": "string"
        }
      },
      "required": [
        "decisionRole",
        "sourceQuote"
      ],
      "title": "CommercialPersona",
      "type": "object"
    },
    "CommercialProduct": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/ProductRelationship"
        },
        "sourceQuote": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Sourcequote",
          "type": "string"
        }
      },
      "required": [
        "name",
        "relationship",
        "sourceQuote"
      ],
      "title": "CommercialProduct",
      "type": "object"
    },
    "DecisionRole": {
      "enum": [
        "DECISION_MAKER",
        "INFLUENCER",
        "USER",
        "UNKNOWN"
      ],
      "title": "DecisionRole",
      "type": "string"
    },
    "ProductRelationship": {
      "enum": [
        "CURRENT",
        "OPPORTUNITY",
        "COMPETITOR",
        "MENTIONED"
      ],
      "title": "ProductRelationship",
      "type": "string"
    },
    "Sentiment": {
      "enum": [
        "POSITIVE",
        "NEUTRAL",
        "NEGATIVE",
        "MIXED"
      ],
      "title": "Sentiment",
      "type": "string"
    },
    "TopicSentiment": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Topic",
          "type": "string"
        },
        "sentiment": {
          "$ref": "#/$defs/Sentiment"
        },
        "sourceQuote": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Sourcequote",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "sentiment",
        "sourceQuote"
      ],
      "title": "TopicSentiment",
      "type": "object"
    },
    "CommercialIntelligence": {
      "additionalProperties": false,
      "description": "Evidence-backed observations, separate from participant identity and sales forecasts.",
      "properties": {
        "products": {
          "items": {
            "$ref": "#/$defs/CommercialProduct"
          },
          "maxItems": 30,
          "title": "Products",
          "type": "array"
        },
        "personas": {
          "items": {
            "$ref": "#/$defs/CommercialPersona"
          },
          "maxItems": 30,
          "title": "Personas",
          "type": "array"
        },
        "budgets": {
          "items": {
            "$ref": "#/$defs/CommercialBudget"
          },
          "maxItems": 30,
          "title": "Budgets",
          "type": "array"
        },
        "sentimentByTopic": {
          "items": {
            "$ref": "#/$defs/TopicSentiment"
          },
          "maxItems": 30,
          "title": "Sentimentbytopic",
          "type": "array"
        }
      },
      "title": "CommercialIntelligence",
      "type": "object"
    }
  }
}
